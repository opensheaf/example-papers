@Article{DW2016,
  Title                    = {Swiveled {R}{\'e}nyi entropies},
  Author                   = {Dupuis, Fr{\'e}d{\'e}ric and Wilde, Mark M.},
  Journal                  = {Quantum Information Processing},
  Year                     = {2016},

  Month                    = {March},
  Note                     = {arXiv:1506.00981},
  Number                   = {3},
  Pages                    = {1309--1345},
  Volume                   = {15},

  Abstract                 = {This paper introduces ``swiveled R{\'e}nyi entropies'' as an alternative to the R{\'e}nyi entropic quantities put forward in Berta et al. (Phys Rev A 91(2):022333, 2015). What distinguishes the swiveled R{\'e}nyi entropies from the prior proposal of Berta et al. is that there is an extra degree of freedom: an optimization over unitary rotations with respect to particular fixed bases (swivels). A consequence of this extra degree of freedom is that the swiveled R{\'e}nyi entropies are ordered, which is an important property of the R{\'e}nyi family of entropies. The swiveled R{\'e}nyi entropies are, however, generally discontinuous at {\$}{\$}{\backslash}alpha =1{\$}{\$} $\alpha$ = 1 and do not converge to the von Neumann entropy-based measures in the limit as {\$}{\$}{\backslash}alpha {\backslash}rightarrow 1{\$}{\$} $\alpha$ {\textrightarrow} 1 , instead bounding them from above and below. Particular variants reduce to known R{\'e}nyi entropies, such as the R{\'e}nyi relative entropy or the sandwiched R{\'e}nyi relative entropy, but also lead to ordered R{\'e}nyi conditional mutual information and ordered R{\'e}nyi generalizations of a relative entropy difference. Refinements of entropy inequalities such as monotonicity of quantum relative entropy and strong subadditivity follow as a consequence of the aforementioned properties of the swiveled R{\'e}nyi entropies. Due to the lack of convergence at {\$}{\$}{\backslash}alpha =1{\$}{\$} $\alpha$ = 1 , it is unclear whether the swiveled R{\'e}nyi entropies would be useful in one-shot information theory, so that the present contribution represents partial progress toward this goal.},
  Doi                      = {10.1007/s11128-015-1211-x},
  ISSN                     = {1573-1332},
  Owner                    = {mwilde},
  Timestamp                = {2016.07.19},
  Url                      = {http://dx.doi.org/10.1007/s11128-015-1211-x}
}

@Article{ESW02,
  Title                    = {Semicausal operations are semilocalizable},
  Author                   = {T. Eggeling and D. Schlingemann and Reinhard F. Werner},
  Journal                  = {Europhysics Letters},
  Year                     = {2002},

  Month                    = {March},
  Note                     = {arXiv:quant-ph/0104027},
  Number                   = {6},
  Pages                    = {782--788},
  Volume                   = {57},

  Abstract                 = {We prove a conjecture by DiVincenzo, which in the
terminology of Preskill et al. states that “semicausal operations
are semilocalizable”. That is, we show that any operation on the
combined system of Alice and Bob, which does not allow Bob to send
messages to Alice, can be represented as an operation by Alice,
transmitting a quantum particle to Bob, and a local operation by
Bob. The proof is based on the uniqueness of the Stinespring
representation for a completely positive map. We sketch some of
the problems in transferring these concepts to the context of
relativistic quantum field theory.},
  Doi                      = {10.1209/epl/i2002-00579-4},
  Owner                    = {mwilde},
  Publisher                = {{IOP} Publishing},
