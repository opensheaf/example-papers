  Mendeley-groups          = {2018},
  Owner                    = {mwilde},
  Timestamp                = {2019.06.13},
  Url                      = {http://stacks.iop.org/0036-0279/52/i=6/a=R02?key=crossref.9a3dd3d906e4a9338822c6992ae26e8a}
}

