@Article{Buscemi2016,
  Title                    = {Degradable channels, less noisy channels, and quantum statistical morphisms: An equivalence relation},
  Author                   = {Buscemi, Francesco},
  Journal                  = {Problems of Information Transmission},
  Year                     = {2016},

  Month                    = {July},
